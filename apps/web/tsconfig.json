{
  "extends": ["@tsconfig/svelte/tsconfig.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "target": "ES2022",
    "sourceMap": false,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "test/**/*.ts", "e2e/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
