    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@zip.js/zip.js": "2.24.0",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
